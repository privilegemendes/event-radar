
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MEMBER
}

enum EventType {
  CONFERENCE
  MEETUP
  EVENT
  PODCAST
  WEBINAR
}

enum EventStatus {
  DISCOVERED
  APPROVED
  PITCHED
  ACCEPTED
  SPOKEN
  REJECTED
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Legacy: passwords now live in Account.password (providerId "credential").
  /// Kept nullable as a rollback net for the Better Auth migration; drop it in a
  /// later change once sign-in has been exercised in production.
  passwordHash String?

  role               Role     @default(MEMBER)
  mustChangePassword Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  image              String?
  createdAt          DateTime @default(now())
  /// @default(now()) is required as well as @updatedAt: without it the column
  /// cannot be added NOT NULL to a table that already has rows.
  updatedAt          DateTime @default(now()) @updatedAt

  sessions       Session[]
  accounts       Account[]
  speakerProfile SpeakerProfile?
  opportunities  EventOpportunity[]

  /// NOTE: the Better Auth CLI writes `@@map("user")` here. It is removed on
  /// purpose — this table already exists as "User" with data, and the map would
  /// rename it. Better Auth reaches the table through Prisma Client (db.user),
  /// so the physical name is irrelevant to it. Re-running `auth generate` will
  /// re-add the map; delete it again.
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
}

model Partner {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  stage       String
  stageStatus String
  country     String
  keyContact  String
  notes       String
  region      String? // NAMER | EMEA | LATAM | APAC
  tier        String? // T1 | T2 | T3
  events      Event[]
  createdAt   DateTime @default(now())
}

model Event {
  id              String      @id @default(cuid())
  title           String
  type            EventType
  startDate       DateTime?
  endDate         DateTime?
  location        String?
  isOnline        Boolean     @default(false)
  region          String? // macro region: North America | UK | Europe | Middle East | Africa | Asia Pacific | Online | Other
  city            String? // specific city, e.g. "San Francisco", "London", "Amsterdam", "Austin"
  coderRelevant   Boolean     @default(false)
  ownerOnly       Boolean     @default(false) // private to the owner (e.g. nomad-related events)
  category        String? // ATTEND | PARTICIPATE | SPEAK (top-level track)
  audienceSignals String? // JSON array of audience tags (DEVELOPERS, CUSTOMERS, WOMEN_IN_TECH, …)
  status          EventStatus @default(DISCOVERED)
  cfpDeadline     DateTime?
  url             String?
  contact         String?
  description     String?
  sourceNote      String?
  partnerId       String?
  partner         Partner?    @relation(fields: [partnerId], references: [id])
  pitchDraft      String?
  followUpAt      DateTime?

  // ── Opportunity intelligence ──
  isPaid               Boolean? // true = speaker paid (honorarium), false = unpaid, null = unknown
  paidNote             String? // e.g. "€500 honorarium" or "speakers pay own travel"
  ticketCost           String? // cost to ATTEND / ticket price, e.g. "Free", "~€1,995 (approx)", "From €99"
  audienceDescription  String? // who the audience is
  audienceSize         Int? // estimated total audience
  otherSpeakers        String? // notable confirmed / past speakers
  acceptanceLikelihood String? // HIGH | MEDIUM | LOW
  acceptanceRationale  String? // one sentence explaining the rating
  howToApply           String? // CFP form URL, email, LinkedIn DM, etc.

  // ── Speaker fit analysis ──
  industry           String? // e.g. "startups/entrepreneurship", "enterprise IT", "digital nomads"
  relevancyScore     Int? // 0-100: how realistic/valuable for Irmak to get a speaking slot
  relevancyRationale String? // 1-2 sentences explaining the score
  suggestedAction    String? // ATTEND | APPLY_TO_SPEAK | BOTH

  // ── Readiness tracking ──
  attending   Boolean @default(false) // user explicitly marked as attending
  readiness   String? // JSON: { [checklistKey]: boolean }
  prepStage   String? // current preparation stage key
  customTasks String? // JSON: [{id, label, done}]

  // ── Application links ──
  applyUrl    String? // direct CFP / speaker application (SPEAK) page URL
  attendUrl   String? // direct attendee registration / tickets (ATTEND) page URL
  socialLinks String? // JSON: {linkedin, instagram, twitter, youtube, facebook}

  // ── Coder company events ──
  isCoderEvent Boolean @default(false) // event is on the official Coder event schedule

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities EventOpportunity[]
}

model Speaker {
  id           String   @id @default(cuid())
  name         String   @unique
  title        String? // job title / role
  company      String?
  linkedinUrl  String? // direct profile URL if found
  background   String? // short bio / why relevant
  topics       String? // comma-separated talk topics
  region       String?
  talkCount    Int      @default(0) // how often they speak across tracked events
  eventsJson   String? // JSON array: [{ id, title, startDate }]
  outreachNote String? // generated personalized LinkedIn invite note
  sourceNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON or plain string; may hold secrets (e.g. calendar ICS URL)
  updatedAt DateTime @updatedAt
}

model DiscoveryRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")
  summary    String?
  found      Int       @default(0)
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// One speaker's brief: who they are, and what discovery should look for.
///
/// Phase 0 of the per-speaker split. Previously a single global JSON blob in
/// AppSetting["applicant_profile"], which allowed exactly one speaker for the
/// whole installation. Keyed by user now so a second speaker is a row rather
/// than a schema change — but nothing reads it per-session yet: the accessors
/// still resolve the owner's profile, so behaviour is unchanged until Phase 2.
///
/// Fields are columns rather than JSON so they are queryable and typed; adding
/// a brief field is a migration, which is the intended trade.

model SpeakerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Applicant fields (fill in CFP forms) ──
  fullName    String @default("")
  jobTitle    String @default("")
  company     String @default("")
  email       String @default("")
  phone       String @default("")
  location    String @default("")
  linkedin    String @default("")
  twitter     String @default("")
  website     String @default("")
  headshotUrl String @default("")
  bioShort    String @default("")
  bioLong     String @default("")
  talkTopics  String @default("")
  dietary     String @default("")
  pronouns    String @default("")

  // ── Speaker brief (steers AI discovery, scoring and pitches) ──
  speakingLevel   String @default("")
  signatureTopics String @default("")
  homeGeographies String @default("")
  credentials     String @default("")
  employerAngle   String @default("")
  excludedDomains String @default("")
  privateKeywords String @default("")
  rubricOverride  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// One speaker's view of one event.
///
/// Phase 1 of the per-speaker split. These columns live on Event today, which
/// means the catalogue stores a single speaker's opinion of each event and a
/// second speaker cannot hold their own without overwriting it.
///
/// Nothing reads this table yet — the Event columns remain authoritative until
/// Phase 2 switches the reads. It exists so the migrated data can be inspected
/// before anything depends on it.

model EventOpportunity {
  id      String @id @default(cuid())
  userId  String
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // ── Scoring: this speaker's fit for this event ──
  relevancyScore       Int?
  relevancyRationale   String?
  acceptanceLikelihood String? // HIGH | MEDIUM | LOW
  acceptanceRationale  String?
  suggestedAction      String? // ATTEND | APPLY_TO_SPEAK | BOTH

  /// ATTEND | PARTICIPATE | SPEAK. Per speaker, not per event: the same
  /// conference is a SPEAK for one person and an ATTEND for another.
  category String?

  /// Renamed from Event.coderRelevant. It has been derived from the speaker's
  /// own employerAngle since the brief became configurable, so it follows the
  /// speaker; only isCoderEvent and the partner link are truly employer data.
  employerRelevant Boolean @default(false)

  // ── Pipeline ──
  status     EventStatus @default(DISCOVERED)
  pitchDraft String?
  followUpAt DateTime?

  // ── Personal tracking ──
  attending   Boolean @default(false)
  readiness   String? // JSON: { [checklistKey]: boolean }
  prepStage   String?
  customTasks String? // JSON: [{id, label, done}]

  /// Renamed from Event.ownerOnly. Once opportunities belong to people,
  /// "owner-only" is just "this speaker's row", so the flag only has to say
  /// whether they want it hidden from a shared view.
  private Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(cuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]
  userId                           String?
  createdAt                        DateTime?             @default(now())
  updatedAt                        DateTime?             @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?
  referenceId                      String?
  metadata                         Json?
  userRel                          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClientResources             OauthClientResource[]
  oauthRefreshTokens               OauthRefreshToken[]
  oauthAccessTokens                OauthAccessToken[]
  oauthConsents                    OauthConsent[]

  @@map("oauth_client")
  @@index([userId])
}

model OauthResource {
  id                            String                @id @default(cuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?
  disabled                      Boolean?
  createdAt                     DateTime?             @default(now())
  updatedAt                     DateTime?             @updatedAt
  policyVersion                 Int?
  metadata                      Json?
  oauthClientResources          OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id          String        @id @default(cuid())
  clientId    String
  resourceId  String
  metadata    Json?
  createdAt   DateTime?     @default(now())
  clientRel   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceRel OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@map("oauth_client_resource")
  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  clientRel               OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionRel              Session?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userRel                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens       OauthAccessToken[]

  @@map("oauth_refresh_token")
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]
  clientRel               OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionRel              Session?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userRel                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshRel              OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@map("oauth_access_token")
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  clientRel               OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userRel                 User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_consent")
  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id @default(cuid())
  expiresAt DateTime

  @@map("oauth_client_assertion")
}
